# Backend-only env names. Prefer the repo-root `.env.example` for the full list.
# Copy to `backend/.env` for local uvicorn. Never commit secrets.

HOST=127.0.0.1
PORT=8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CUSTOM_POSE_MODEL=
ANALYSIS_IMGSZ=640
DOG_DETECTION_THRESHOLD=0.55
KEYPOINT_CONF_THRESHOLD=0.42
POSE_QUALITY_THRESHOLD=0.40
TEMPORAL_WINDOW=14
CORS_ORIGINS=*
