# PetTalk Vision — environment variable names only (no secrets).
# Copy to `.env` locally. Never commit real keys.

# --- Backend (Railway + local uvicorn) ---
# Local: keep HOST=127.0.0.1
# Docker/Railway: container CMD binds 0.0.0.0; Railway injects PORT automatically
HOST=127.0.0.1
PORT=8000

# Optional LLM copy for /explain and /summarize (demo works without this)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional custom Ultralytics checkpoint path (defaults to models/yolo11n-seg.pt)
CUSTOM_POSE_MODEL=

# Inference / thresholds (optional overrides)
ANALYSIS_IMGSZ=640
DOG_DETECTION_THRESHOLD=0.55
KEYPOINT_CONF_THRESHOLD=0.42
POSE_QUALITY_THRESHOLD=0.40
TEMPORAL_WINDOW=14

# Comma-separated browser origins, or * for the prototype
# Example after Vercel deploy:
# CORS_ORIGINS=https://your-app.vercel.app,http://127.0.0.1:5173
CORS_ORIGINS=*

# --- Frontend (Vite / Vercel) ---
# Local `npm run dev`: leave these empty so the Vite proxy to 127.0.0.1:8000 is used.
# Vercel production (set in Vercel Project → Settings → Environment Variables):
#   VITE_API_URL=https://YOUR-RAILWAY-SERVICE.up.railway.app
#   VITE_WS_URL=wss://YOUR-RAILWAY-SERVICE.up.railway.app/ws/analyze
VITE_API_URL=
VITE_WS_URL=

# Only needed for GitHub Pages-style subpath hosting (not used on Vercel root deploys)
# VITE_BASE_PATH=/
